{
  "name": "destajo",
  "productName": "desTajo",
  "version": "2.2.1",
  "description": "Herramientas de desarrollo: avisos de menciones de Jira, copia de tareas a Markdown y captura rapida de incidencias",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "serve:dist": "node scripts/serve-dist.js",
    "check:adf": "node scripts/check-adf.js",
    "check:copy": "node scripts/check-copy-flow.js",
    "check:renderer": "node scripts/check-renderer-gitlab.js",
    "check:search": "node scripts/check-search-suggestions.js",
    "check:bugs": "node scripts/check-bug-inbox.js",
    "check:rename": "node scripts/check-rename-migration.js"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.destajo.app",
    "productName": "desTajo",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jlozanoDev",
        "repo": "destajo"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "adf.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "desTajo"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
